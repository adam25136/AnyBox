function(anybox_adapt_shader_bda target root)
    set(original "${root}/SpirvBackend/src/SpirvBdaRead.cpp")
    file(READ "${original}" content)
    string(FIND "${content}" "std::uint32_t EmitBdaAtomic(" start)
    if(start EQUAL -1)
        message(FATAL_ERROR "The pinned shader backend does not expose its expected BDA atomic adapter")
    endif()
    string(SUBSTRING "${content}" ${start} -1 tail)
    string(FIND "${tail}" "\n}\n" end)
    if(end EQUAL -1)
        message(FATAL_ERROR "The pinned shader BDA atomic function has no expected boundary")
    endif()
    math(EXPR length "${end} + 3")
    string(SUBSTRING "${tail}" 0 ${length} body)
    set(originalBody "${body}")
    anybox_replace_shader_text(body "state.bdaWritePointerFunction" "state.bdaAtomicPointerFunction")
    anybox_replace_shader_text(body "BDA write functions are missing" "BDA atomic functions are missing")
    anybox_replace_shader_text(content "${originalBody}" "${body}")
    anybox_overlay_shader_source(${target} "${original}" "${content}")
endfunction()
