function(anybox_add_dxil_spirv)
    set(DXIL_SPIRV_CLI OFF CACHE BOOL "" FORCE)
    set(DXIL_SPIRV_NATIVE_LLVM OFF CACHE BOOL "" FORCE)
    set(DXIL_SPV_MISC_CLI OFF CACHE BOOL "" FORCE)
    set(DXIL_SPV_FUZZ_CLI OFF CACHE BOOL "" FORCE)
    add_subdirectory("${PROJECT_SOURCE_DIR}/3rdparty/dxil-spirv" "${CMAKE_BINARY_DIR}/3rdparty/dxil-spirv" EXCLUDE_FROM_ALL)
    include("${PROJECT_SOURCE_DIR}/cmake/DxilBitcode.cmake")
    anybox_adapt_dxil_bitcode()
    if(MSVC)
        foreach(target dxil-debug dxil-utils bc-decoder llvm-bc glslang-spirv-builder spirv-module dxil-converter dxil-spirv-c-shared dxil-spirv-c-static dxbc-spirv dxbc-spirv-test)
            set_property(TARGET ${target} PROPERTY COMPILE_OPTIONS /W3 /GR- /EHs-c- /utf-8)
            target_compile_definitions(${target} PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN _CRT_SECURE_NO_WARNINGS)
        endforeach()
    endif()
    set_target_properties(dxil-spirv-c-shared PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${ANYBOX_RUNTIME_DIRECTORY}" ARCHIVE_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/lib/$<CONFIG>")
endfunction()
