function(anybox_replace_shader_text variable needle replacement)
    string(FIND "${${variable}}" "${needle}" position)
    if(position EQUAL -1)
        message(FATAL_ERROR "The pinned shader source no longer matches its compiler adapter: ${needle}")
    endif()
    string(REPLACE "${needle}" "${replacement}" updated "${${variable}}")
    set(${variable} "${updated}" PARENT_SCOPE)
endfunction()

function(anybox_overlay_shader_source target original content)
    get_filename_component(name "${original}" NAME)
    get_filename_component(directory "${original}" DIRECTORY)
    set(output "${CMAKE_BINARY_DIR}/generated/shader-compatibility/${name}")
    file(GENERATE OUTPUT "${output}" CONTENT "${content}")
    get_target_property(sources ${target} SOURCES)
    if(NOT "${original}" IN_LIST sources)
        message(FATAL_ERROR "The pinned shader target does not contain ${original}")
    endif()
    list(REMOVE_ITEM sources "${original}")
    set_property(TARGET ${target} PROPERTY SOURCES "${sources}")
    target_sources(${target} PRIVATE "${output}")
    set_property(SOURCE "${output}" TARGET_DIRECTORY ${target} PROPERTY INCLUDE_DIRECTORIES "${directory}")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${original}")
endfunction()

function(anybox_adapt_shader_compiler target root)
    set(flow "${root}/SpirvBackend/src/SpirvFlowEmitter.cpp")
    file(READ "${flow}" content)
    anybox_replace_shader_text(content "#include \"SpirvBackend/SpirvFlowEmitter.hpp\"" "#include \"SpirvBackend/SpirvFlowEmitter.hpp\"\n#include \"${CMAKE_SOURCE_DIR}/core/shader/src/backend/AnyBoxDivision.hpp\"\n#include \"${CMAKE_SOURCE_DIR}/core/shader/src/backend/AnyBoxBarrier.hpp\"")
    anybox_replace_shader_text(content "case IrOpcode::FPAdd32: return Invoke(EmitFPAdd32, ctx, inst);" "case IrOpcode::FDiv32: return Invoke(AnyBox::Shader::Backend::EmitDivision, ctx, inst);\n        case IrOpcode::FPAdd32: return Invoke(EmitFPAdd32, ctx, inst);")
    anybox_replace_shader_text(content "case IrOpcode::Barrier: return Invoke(EmitBarrier, ctx, inst);" "case IrOpcode::Barrier: return Invoke(AnyBox::Shader::Backend::EmitDxilBarrier, ctx, inst);")
    anybox_overlay_shader_source(${target} "${flow}" "${content}")
    target_sources(${target} PRIVATE "${CMAKE_SOURCE_DIR}/core/shader/src/backend/AnyBoxDivision.cpp")
    target_sources(${target} PRIVATE "${CMAKE_SOURCE_DIR}/core/shader/src/backend/AnyBoxBarrier.cpp")
    set(specialization "${root}/SpirvBackend/src/SpirvSpecialization.cpp")
    file(READ "${specialization}" content)
    anybox_replace_shader_text(content "std::array<std::uint32_t, 3>{op, instruction[1], instruction[3]}" "std::array<std::uint32_t, 3>{static_cast<std::uint32_t>(op), instruction[1], instruction[3]}")
    anybox_overlay_shader_source(${target} "${specialization}" "${content}")
    if(CMAKE_CXX_COMPILER_ID STREQUAL "MSVC")
        set(recompiler "${root}/Recompiler.cpp")
        file(READ "${recompiler}" content)
        foreach(pass SsaBuilder ConstantFolder DeadCodeEliminator ReadLaneEliminator MaskedSelectEliminator VectorWindowIndexNarrower VectorWindowStoreEliminator)
            anybox_replace_shader_text(content "constexpr ${pass} " "const ${pass} ")
        endforeach()
        anybox_overlay_shader_source(${target} "${recompiler}" "${content}")
        set(descriptors "${root}/Optimization/src/SrtWalker/SrtDescriptorEvaluation.cpp")
        file(READ "${descriptors}" content)
        anybox_replace_shader_text(content "#include <cstdio>" "#include <cstdio>\n#include <xmmintrin.h>")
        anybox_replace_shader_text(content "__builtin_prefetch(bytesData + offset)" "_mm_prefetch(bytesData + offset, _MM_HINT_T0)")
        anybox_overlay_shader_source(${target} "${descriptors}" "${content}")
    endif()
endfunction()
