function(anybox_add_shader_recompiler)
    set(PROJECT_SOURCE_DIR "${CMAKE_SOURCE_DIR}/3rdparty/anyps5")
    set(BUILD_TESTING OFF)
    set(ANYPS5_ENABLE_SPIRV_TOOLS OFF)
    set(ANYPS5_USE_SYSTEM_DEPS OFF)
    set(ANYPS5_SPIRV_HEADERS_SOURCE_DIR "${CMAKE_SOURCE_DIR}/3rdparty/SPIRV-Headers")
    set(ANYPS5_SPIRV_HEADERS_INCLUDE_DIR "${ANYPS5_SPIRV_HEADERS_SOURCE_DIR}/include")
    set(ANYPS5_GLSLANG_SOURCE_DIR "${CMAKE_SOURCE_DIR}/3rdparty/glslang")
    set(ANYPS5_GLSLANG_INCLUDE_DIRS "${ANYPS5_GLSLANG_SOURCE_DIR}")
    include("${PROJECT_SOURCE_DIR}/core/shader/recompiler/CMakeLists.txt")
    add_shader_recompiler(anybox_shader_recompiler anybox_shader_host)
    set_property(TARGET anybox_shader_recompiler PROPERTY SYSTEM TRUE)
    get_target_property(recompilerSources anybox_shader_recompiler SOURCES)
    set(scratchSource "${PROJECT_SOURCE_DIR}/core/shader/recompiler/SpirvBackend/src/SpirvMemory/SpirvScratchPool.cpp")
    if(NOT "${scratchSource}" IN_LIST recompilerSources)
        message(FATAL_ERROR "The pinned shader backend does not expose its expected scratch storage adapter")
    endif()
    list(REMOVE_ITEM recompilerSources "${scratchSource}")
    set_property(TARGET anybox_shader_recompiler PROPERTY SOURCES "${recompilerSources}")
    target_sources(anybox_shader_recompiler PRIVATE "${CMAKE_SOURCE_DIR}/core/shader/src/backend/FunctionScratch.cpp")
    target_compile_definitions(anybox_shader_recompiler PUBLIC NOMINMAX WIN32_LEAN_AND_MEAN)
    target_compile_definitions(anybox_shader_recompiler PRIVATE _CRT_SECURE_NO_WARNINGS)
    target_include_directories(anybox_shader_recompiler PRIVATE "${CMAKE_SOURCE_DIR}/core/common/include")
    if(MSVC)
        target_include_directories(anybox_shader_recompiler PRIVATE "${CMAKE_SOURCE_DIR}/core/shader/platform/windows")
        set_property(TARGET anybox_shader_recompiler PROPERTY COMPILE_OPTIONS "/FI${PROJECT_SOURCE_DIR}/core/libs/prx/libc/include/HostStandardStreams.hpp" /EHsc)
    endif()
    include("${CMAKE_SOURCE_DIR}/cmake/ShaderCompatibility.cmake")
    anybox_adapt_shader_compiler(anybox_shader_recompiler "${PROJECT_SOURCE_DIR}/core/shader/recompiler")
    include("${CMAKE_SOURCE_DIR}/cmake/ShaderBda.cmake")
    anybox_adapt_shader_bda(anybox_shader_recompiler "${PROJECT_SOURCE_DIR}/core/shader/recompiler")
endfunction()
